# VALORIS local development configuration. Never commit real values.
DATABASE_URL=postgresql://valoris:valoris@localhost:5432/valoris
AUTH_ISSUER_URL=http://localhost:3000
AUTH_CLIENT_ID=local-dev
AUTH_CLIENT_SECRET=replace-me
APP_BASE_URL=http://localhost:3000
OBJECT_STORAGE_BUCKET=valoris-local
QUEUE_URL=redis://localhost:6379
LLM_PROVIDER=disabled
LLM_API_KEY=
AGENT_MODEL=disabled
ENCRYPTION_KEY=replace-with-32-byte-local-key
LOG_LEVEL=info
DEFAULT_CURRENCY=USD
CPI_WATCH_THRESHOLD=0.95
CPI_RISK_THRESHOLD=0.90
SPI_WATCH_THRESHOLD=0.95
SPI_RISK_THRESHOLD=0.90
